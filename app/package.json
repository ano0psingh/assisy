{
  "name": "assisy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:quality": "eslint playwright.config.ts tests/browser/quality.spec.ts scripts/check-sync-multiclient.mjs src/hooks/useDialogFocus.ts src/store/merge.ts src/store/outbox.ts src/store/unifiedStore.ts src/store/cloudStore.ts src/components/common/QuickCaptureFAB.tsx src/components/common/SelectionControls.tsx src/components/common/TiptapViewer.tsx src/components/tasks/TaskCard.tsx src/components/tasks/ClarifyTaskSheet.tsx src/pages/Goals.tsx",
    "check:merge": "node scripts/check-merge.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "check:sync-multiclient": "node scripts/check-sync-multiclient.mjs",
    "check:scheduling": "node scripts/check-scheduling.mjs",
    "check:calendar": "node scripts/check-calendar.mjs",
    "check:goals": "node scripts/check-goals.mjs",
    "check:reminders": "node scripts/check-reminders.mjs",
    "check:ics": "node scripts/check-ics.mjs",
    "check:classes": "node scripts/check-dead-classes.mjs",
    "check:ai": "node --experimental-strip-types scripts/check-ai-boundary.mjs",
    "check:deterministic": "npm run check:merge && npm run check:sync && npm run check:sync-multiclient && npm run check:scheduling && npm run check:calendar && npm run check:goals && npm run check:reminders && npm run check:ics && npm run check:classes && npm run check:ai",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:a11y": "playwright test --grep @a11y",
    "test:browser": "playwright test",
    "test:quality": "npm run check:deterministic && npm run lint:quality && npm run build && npm run test:browser",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@google/genai": "^1.43.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-task-item": "^3.20.1",
    "@tiptap/extension-task-list": "^3.20.1",
    "@tiptap/extension-underline": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@types/uuid": "^10.0.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.8.0",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^5.6.10",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
